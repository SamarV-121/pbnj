---
import Layout from '@/layouts/Layout.astro';
import config from '@/lib/config';
import { MAX_READ_LIMIT } from '@/lib/reads';
---

<Layout title={`New Paste - ${config.name}`}>
	<div class="max-w-6xl mx-auto pb-12">
		<!-- Header row -->
		<div class="mb-3 flex items-center justify-between gap-3">
			<!-- Editable title -->
			<input
				type="text"
				id="filename"
				class="text-xl sm:text-2xl font-medium text-paper-text truncate"
				placeholder="snippet"
				style="outline: none; border: none; flex: 1; min-width: 0; background: transparent;"
			/>

			<!-- Action buttons -->
			<div class="flex gap-3 flex-shrink-0">
				<!-- Language selector -->
				<select
					id="language"
					class="p-2 text-paper-text bg-paper-bg2 border border-paper-border rounded hover:border-paper-border-hover transition-colors cursor-pointer"
					title="Select language"
					style="outline: none;"
				>
					<option value="">auto</option>
					<option value="javascript">JS</option>
					<option value="typescript">TS</option>
					<option value="python">Python</option>
					<option value="rust">Rust</option>
					<option value="go">Go</option>
					<option value="java">Java</option>
					<option value="c">C</option>
					<option value="cpp">C++</option>
					<option value="csharp">C#</option>
					<option value="ruby">Ruby</option>
					<option value="php">PHP</option>
					<option value="swift">Swift</option>
					<option value="kotlin">Kotlin</option>
					<option value="html">HTML</option>
					<option value="css">CSS</option>
					<option value="json">JSON</option>
					<option value="yaml">YAML</option>
					<option value="markdown">MD</option>
					<option value="bash">Bash</option>
					<option value="sql">SQL</option>
					<option value="plaintext">Text</option>
				</select>

				<!-- Expiry selector -->
				<select
					id="expires"
					class="p-2 text-paper-text bg-paper-bg2 border border-paper-border rounded hover:border-paper-border-hover transition-colors cursor-pointer"
					title="Expire paste"
					style="outline: none;"
				>
					<option value="">never</option>
					<option value="10m">10m</option>
					<option value="1h">1h</option>
					<option value="1d">1d</option>
					<option value="1w">1w</option>
				</select>

				<!-- Read limit: the paste burns after this many reads -->
				<input
					id="max-reads"
					type="number"
					min="1"
					max={MAX_READ_LIMIT}
					step="1"
					placeholder="max reads"
					title="Burn after this many reads (blank for no limit)"
					class="p-2 w-28 text-paper-text bg-paper-bg2 border border-paper-border rounded hover:border-paper-border-hover transition-colors"
					style="outline: none;"
				/>

				<!-- Image upload -->
				<button
					id="image-btn"
					type="button"
					class="p-2 px-4 text-paper-text bg-paper-bg2 border border-paper-border rounded hover:border-paper-border-hover transition-colors"
					title="Add images"
				>
					Image
				</button>
				<input type="file" id="image-input" accept="image/png,image/jpeg,image/webp,image/gif" multiple hidden />

				<!-- Private toggle -->
				<button
					id="private-btn"
					class="p-2 text-paper-text bg-paper-bg2 border border-paper-border rounded hover:border-paper-border-hover transition-colors"
					title="Toggle private"
				>
					<!-- Unlocked icon (default) -->
					<svg id="lock-open" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
						<path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
					</svg>
					<!-- Locked icon (when private) -->
					<svg id="lock-closed" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
						<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
						<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
					</svg>
				</button>

				<!-- Save button -->
				<button
					id="create-btn"
					class="p-2 text-paper-text bg-paper-bg2 border border-paper-border rounded hover:border-paper-border-hover transition-colors"
					title="Save paste"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
						<polyline points="17 21 17 13 7 13 7 21"></polyline>
						<polyline points="7 3 7 8 15 8"></polyline>
					</svg>
				</button>
			</div>
		</div>

		<!-- Password row (shown when private) -->
		<div id="password-row" class="mb-3" style="display: none;">
			<input
				type="password"
				id="password"
				class="w-full p-2 text-paper-text bg-paper-bg2 border border-paper-border rounded"
				placeholder="password to open this paste (optional)"
				autocomplete="new-password"
				style="outline: none;"
			/>
			<label id="clear-password-row" class="mt-2 flex items-center gap-2 text-sm text-paper-muted" style="display: none;">
				<input type="checkbox" id="clear-password" />
				Remove the current password
			</label>
		</div>

		<!-- Code editor card -->
		<div id="editor-wrapper" class="border border-paper-border rounded overflow-hidden bg-paper-bg2" style="transition: border-color 0.3s ease;">
			<textarea
				id="code-input"
				class="w-full bg-paper-bg2 text-paper-text resize-none"
				placeholder="paste your code here..."
				spellcheck="false"
				style="min-height: 480px; padding: 1.5rem; outline: none; line-height: 1.625; font-family: 'SF Mono', Monaco, 'Courier New', monospace; font-size: 0.875rem;"
			></textarea>
		</div>

		<!-- Uploaded images; Markdown notes also get a reference inserted at the cursor -->
		<div id="image-list" class="mt-3 flex flex-wrap gap-3"></div>
	</div>
</Layout>

<script>
	import { ALLOWED_IMAGE_TYPES, MAX_IMAGE_BYTES, MAX_IMAGE_DIMENSION, MAX_IMAGES_PER_PASTE } from '../lib/images';

	// Check if logged in
	const isLoggedIn = localStorage.getItem('pbnj_logged_in');
	if (!isLoggedIn) {
		window.location.href = '/login?return=' + encodeURIComponent(location.pathname + location.search);
	}

	// ?edit=ID opens an existing paste for editing; ?key= is kept so keyed pastes still open after saving
	const params = new URLSearchParams(location.search);
	const editId = params.get('edit');
	const editKey = params.get('key');

	const codeInput = document.getElementById('code-input') as HTMLTextAreaElement;
	const filenameInput = document.getElementById('filename') as HTMLInputElement;
	const languageSelect = document.getElementById('language') as HTMLSelectElement;
	const expiresSelect = document.getElementById('expires') as HTMLSelectElement;
	const maxReadsInput = document.getElementById('max-reads') as HTMLInputElement;
	// The read limit is only set at creation
	if (editId) maxReadsInput.hidden = true;
	const privateBtn = document.getElementById('private-btn') as HTMLButtonElement;
	const lockOpen = document.getElementById('lock-open') as SVGElement;
	const lockClosed = document.getElementById('lock-closed') as SVGElement;
	const createBtn = document.getElementById('create-btn') as HTMLButtonElement;
	const editorWrapper = document.getElementById('editor-wrapper') as HTMLDivElement;
	const passwordRow = document.getElementById('password-row') as HTMLDivElement;
	const passwordInput = document.getElementById('password') as HTMLInputElement;
	const clearPasswordRow = document.getElementById('clear-password-row') as HTMLLabelElement;
	const clearPasswordInput = document.getElementById('clear-password') as HTMLInputElement;
	const imageBtn = document.getElementById('image-btn') as HTMLButtonElement;
	const imageInput = document.getElementById('image-input') as HTMLInputElement;
	const imageList = document.getElementById('image-list') as HTMLDivElement;

	let isPrivate = false;
	// Attached image IDs in display order, and how many uploads are in flight
	let images: string[] = [];
	let pendingUploads = 0;

	// Update private button style - just toggle icons, keep same bg as other buttons
	function updatePrivateButton() {
		passwordRow.style.display = isPrivate ? 'block' : 'none';
		if (isPrivate) {
			lockOpen.style.display = 'none';
			lockClosed.style.display = 'block';
		} else {
			lockOpen.style.display = 'block';
			lockClosed.style.display = 'none';
		}
	}

	// Toggle private
	privateBtn.addEventListener('click', () => {
		isPrivate = !isPrivate;
		updatePrivateButton();
	});

	// Initialize button style
	updatePrivateButton();

	// Clearing the password and typing a new one are mutually exclusive
	clearPasswordInput.addEventListener('change', () => {
		passwordInput.disabled = clearPasswordInput.checked;
	});

	function showError() {
		editorWrapper.style.borderColor = '#a63d40';
		editorWrapper.classList.add('shake');

		setTimeout(() => {
			editorWrapper.classList.remove('shake');
		}, 500);

		setTimeout(() => {
			editorWrapper.style.borderColor = 'var(--paper-border)';
		}, 2000);
	}

	async function savePaste() {
		if (pendingUploads > 0) {
			alert('Wait for image uploads to finish');
			return;
		}

		if (!maxReadsInput.reportValidity()) {
			return;
		}

		const code = codeInput.value;
		if (!code.trim()) {
			showError();
			codeInput.focus();
			return;
		}

		createBtn.style.opacity = '0.5';
		createBtn.style.pointerEvents = 'none';

		try {
			const body: Record<string, any> = { code, images };

			if (filenameInput.value.trim()) {
				body.filename = filenameInput.value.trim();
			}
			if (languageSelect.value) {
				body.language = languageSelect.value;
			}
			// When editing, "never" clears an existing expiry and "keep" leaves it alone
			if (editId && expiresSelect.value === '') {
				body.expires = null;
			} else if (expiresSelect.value && expiresSelect.value !== 'keep') {
				body.expires = expiresSelect.value;
			}
			if (!editId && maxReadsInput.value) {
				body.maxReads = Number(maxReadsInput.value);
			}
			if (editId || isPrivate) {
				body.private = isPrivate;
			}
			if (isPrivate && clearPasswordInput.checked) {
				body.password = null;
			} else if (isPrivate && passwordInput.value) {
				body.password = passwordInput.value;
			}

			const response = await fetch(editId ? `/api/${encodeURIComponent(editId)}` : '/api', {
				method: editId ? 'PUT' : 'POST',
				headers: {
					'Content-Type': 'application/json',
				},
				body: JSON.stringify(body),
				credentials: 'same-origin', // Include session cookie
			});

			if (!response.ok) {
				const data = await response.json().catch(() => ({}));
				throw new Error(data.error || 'Failed to create paste');
			}

			const data = await response.json();
			const keyQuery = editKey && isPrivate ? `?key=${encodeURIComponent(editKey)}` : '';
			window.location.href = `/${data.id}${keyQuery}`;
		} catch (err: any) {
			showError();
			createBtn.style.opacity = '1';
			createBtn.style.pointerEvents = 'auto';
		}
	}

	createBtn.addEventListener('click', savePaste);

	// Ctrl/Cmd + Enter or Ctrl/Cmd + S to submit
	codeInput.addEventListener('keydown', (e) => {
		if ((e.ctrlKey || e.metaKey) && (e.key === 'Enter' || e.key === 's')) {
			e.preventDefault();
			savePaste();
		}
	});

	// Global Ctrl/Cmd + S handler
	document.addEventListener('keydown', (e) => {
		if ((e.ctrlKey || e.metaKey) && e.key === 's') {
			e.preventDefault();
			savePaste();
		}
	});

	// Prefill the editor with an existing paste
	async function loadPaste(pasteId: string) {
		const response = await fetch(`/api/${encodeURIComponent(pasteId)}`, {
			credentials: 'same-origin', // Include session cookie
		});
		if (!response.ok) {
			window.location.href = '/404';
			return;
		}

		const data = await response.json();
		filenameInput.value = data.filename || '';
		languageSelect.value = data.language || '';
		codeInput.value = data.code;
		images = Array.isArray(data.images) ? data.images : [];
		renderImages();
		isPrivate = data.private;
		updatePrivateButton();

		// Keep the current expiry unless another option is picked
		expiresSelect.insertBefore(new Option('keep', 'keep'), expiresSelect.firstChild);
		expiresSelect.value = 'keep';

		if (data.hasPassword) {
			clearPasswordRow.style.display = 'flex';
			passwordInput.placeholder = 'new password (leave empty to keep the current one)';
		}
		createBtn.title = 'Save changes';
	}

	if (editId && isLoggedIn) {
		loadPaste(editId);
	}

	// Editor previews reuse the edit key so keyed pastes can still show their images
	function imageUrl(imageId: string) {
		return `/i/${imageId}` + (editKey ? `?key=${encodeURIComponent(editKey)}` : '');
	}

	function renderImages() {
		imageList.replaceChildren(...images.map((imageId) => {
			const item = document.createElement('div');
			item.className = 'flex flex-col gap-2 p-2 border border-paper-border rounded bg-paper-bg2';

			const img = document.createElement('img');
			img.src = imageUrl(imageId);
			img.alt = '';
			img.className = 'h-24 w-auto max-w-[12rem] rounded object-contain';

			const remove = document.createElement('button');
			remove.type = 'button';
			remove.textContent = 'Remove';
			remove.className = 'text-sm text-left text-paper-muted hover:text-paper-text transition-colors';
			remove.addEventListener('click', () => removeImage(imageId));

			item.append(img, remove);
			return item;
		}));
	}

	function removeImage(imageId: string) {
		images = images.filter((id) => id !== imageId);
		// Drop Markdown references so the note doesn't point at a deleted image
		const reference = new RegExp(`!\\[[^\\]]*\\]\\(/i/${imageId}[^)]*\\)\\n?`, 'g');
		codeInput.value = codeInput.value.replace(reference, '');
		renderImages();
	}

	function insertAtCursor(text: string) {
		const start = codeInput.selectionStart;
		const end = codeInput.selectionEnd;
		codeInput.value = codeInput.value.slice(0, start) + text + codeInput.value.slice(end);
		codeInput.selectionStart = codeInput.selectionEnd = start + text.length;
		codeInput.focus();
	}

	function updateImageButton() {
		imageBtn.textContent = pendingUploads > 0 ? 'Uploading...' : 'Image';
	}

	// Files are sent unchanged unless they exceed the size or dimension limits, then re-encoded as WebP
	async function prepareImage(file: File): Promise<Blob> {
		const bitmap = await createImageBitmap(file);
		try {
			const { width, height } = bitmap;
			if (file.size <= MAX_IMAGE_BYTES && Math.max(width, height) <= MAX_IMAGE_DIMENSION) {
				return file;
			}

			let scale = Math.min(1, MAX_IMAGE_DIMENSION / Math.max(width, height));
			for (let attempt = 0; attempt < 8; attempt++) {
				const canvas = document.createElement('canvas');
				canvas.width = Math.max(1, Math.round(width * scale));
				canvas.height = Math.max(1, Math.round(height * scale));
				const context = canvas.getContext('2d');
				if (!context) throw new Error('Canvas is not available');
				context.drawImage(bitmap, 0, 0, canvas.width, canvas.height);

				for (const quality of [0.9, 0.8, 0.7, 0.6]) {
					const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/webp', quality));
					if (blob && blob.size <= MAX_IMAGE_BYTES) return blob;
				}
				scale *= 0.75;
			}
			throw new Error('Image is still too large after compressing');
		} finally {
			bitmap.close();
		}
	}

	async function uploadFiles(files: File[]) {
		const imageFiles = files.filter((file) => ALLOWED_IMAGE_TYPES.includes(file.type));
		for (const file of imageFiles) {
			if (images.length >= MAX_IMAGES_PER_PASTE) {
				alert(`A note can have at most ${MAX_IMAGES_PER_PASTE} images`);
				break;
			}

			pendingUploads++;
			updateImageButton();
			try {
				const body = new FormData();
				body.append('file', await prepareImage(file), file.name);
				const response = await fetch('/api/images', {
					method: 'POST',
					body,
					credentials: 'same-origin', // Include session cookie
				});
				const data = await response.json().catch(() => ({}));
				if (!response.ok) {
					throw new Error(data.error || 'Upload failed');
				}

				images.push(data.id);
				if (languageSelect.value === 'markdown') {
					insertAtCursor(`![image](${data.url})\n`);
				}
			} catch (err: any) {
				alert('Image upload failed: ' + err.message);
			} finally {
				pendingUploads--;
				updateImageButton();
				renderImages();
			}
		}
	}

	imageBtn.addEventListener('click', () => imageInput.click());
	imageInput.addEventListener('change', () => {
		uploadFiles(Array.from(imageInput.files ?? []));
		imageInput.value = '';
	});

	editorWrapper.addEventListener('dragover', (e) => {
		if (e.dataTransfer?.types.includes('Files')) e.preventDefault();
	});
	// File drops are always cancelled so the browser doesn't open them; non-image files are ignored.
	// Text drags have no Files type, so they still land in the editor.
	editorWrapper.addEventListener('drop', (e) => {
		if (!e.dataTransfer?.types.includes('Files')) return;
		e.preventDefault();
		uploadFiles(Array.from(e.dataTransfer.files));
	});

	// Focus textarea on load
	codeInput.focus();
</script>

<style>
	textarea::placeholder {
		color: var(--paper-muted);
	}

	#filename::placeholder {
		color: var(--paper-text);
		opacity: 1;
	}

	@keyframes shake {
		0%, 100% { transform: translateX(0); }
		10%, 30%, 50%, 70%, 90% { transform: translateX(-4px); }
		20%, 40%, 60%, 80% { transform: translateX(4px); }
	}

	.shake {
		animation: shake 0.5s ease-in-out;
	}
</style>
