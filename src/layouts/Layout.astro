---
import config, { theme } from '@/lib/config';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "A minimal pastebin for code snippets" } = Astro.props;
const siteUrl = Astro.url.origin;
const currentUrl = Astro.url.href;

// All themes use local CSS files
const hljsStylePath = `/styles/hljs-${config.theme}.css`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />

		<!-- Highlight.js Theme (local) -->
		<link rel="stylesheet" href={hljsStylePath} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={currentUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={`${siteUrl}/og-image.png`} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${siteUrl}/og-image.png`} />

		<title>{title}</title>
	</head>
	<body class="bg-paper-bg min-h-screen font-sans text-paper-text flex flex-col">
		<header class="sm:fixed sm:top-0 sm:left-0 w-full sm:z-50">
			<div class="max-w-[1600px] mx-auto px-8 py-3 flex items-center justify-between">
				<a href="/" class="hover:opacity-70 transition-opacity inline-block" aria-label={`${config.name} home`}>
					<img src={config.logo} alt={config.name} class="h-8 w-auto" loading="eager" />
				</a>
				<div class="flex items-center gap-3">
					<!-- New paste button (only visible when logged in) -->
					<a id="new-paste-btn" href="/new" class="px-3 py-2 text-sm text-paper-text bg-paper-bg2 border border-paper-border rounded hover:border-paper-border-hover transition-colors" title="New paste" style="display: none;">New paste</a>
					<!-- Auth button: login/logout -->
					<button id="auth-btn" class="px-3 py-2 text-sm text-paper-text bg-paper-bg2 border border-paper-border rounded hover:border-paper-border-hover transition-colors" title="Login">Login</button>
				</div>
			</div>
		</header>
		<script is:inline>
			(function() {
				const authBtn = document.getElementById('auth-btn');
				const newPasteBtn = document.getElementById('new-paste-btn');
				const isLoggedIn = localStorage.getItem('pbnj_logged_in');

				if (isLoggedIn) {
					authBtn.textContent = 'Logout';
					authBtn.title = 'Logout';
					newPasteBtn.style.display = 'block';
				}

				authBtn.addEventListener('click', async () => {
					if (localStorage.getItem('pbnj_logged_in')) {
						// Call logout API to clear session
						await fetch('/api/auth/logout', { method: 'POST' });
						localStorage.removeItem('pbnj_logged_in');
						authBtn.textContent = 'Login';
						authBtn.title = 'Login';
						newPasteBtn.style.display = 'none';
						// Reload to refresh any auth-dependent content
						window.location.reload();
					} else {
						// Store current page to return after login
						const returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
						window.location.href = '/login?return=' + returnUrl;
					}
				});
			})();
		</script>
		<main class="sm:pt-16 px-8 max-w-[1600px] w-full mx-auto flex-1">
			<slot />
		</main>
		{config.footer && (
			<footer class="py-6 text-center text-paper-muted text-sm">
				{config.footer.link ? (
					<a
						href={config.footer.link}
						target="_blank"
						rel="noopener noreferrer"
						class="hover:text-paper-text transition-colors"
					>
						{config.footer.text}
					</a>
				) : (
					<span>{config.footer.text}</span>
				)}
			</footer>
		)}
	</body>
</html>

<style is:global>
	/* Ensure hljs uses theme background */
	.hljs {
		padding: 0 !important;
	}

	/* Shared by the note viewer and the editor preview */
	/* Colors use currentColor so the styles follow the active theme */
	.markdown-body {
		line-height: 1.7;
		overflow-wrap: break-word;
	}
	.markdown-body > :first-child {
		margin-top: 0;
	}
	.markdown-body > :last-child {
		margin-bottom: 0;
	}
	.markdown-body h1,
	.markdown-body h2,
	.markdown-body h3,
	.markdown-body h4 {
		font-weight: 600;
		line-height: 1.3;
		margin: 1.5em 0 0.6em;
	}
	.markdown-body h1 { font-size: 1.75em; padding-bottom: 0.3em; border-bottom: 1px solid color-mix(in srgb, currentColor 15%, transparent); }
	.markdown-body h2 { font-size: 1.4em; padding-bottom: 0.3em; border-bottom: 1px solid color-mix(in srgb, currentColor 15%, transparent); }
	.markdown-body h3 { font-size: 1.2em; }
	.markdown-body p,
	.markdown-body ul,
	.markdown-body ol,
	.markdown-body blockquote,
	.markdown-body table,
	.markdown-body pre {
		margin: 0 0 1em;
	}
	.markdown-body ul { list-style: disc; padding-left: 1.5em; }
	.markdown-body ol { list-style: decimal; padding-left: 1.5em; }
	.markdown-body a { text-decoration: underline; }
	.markdown-body blockquote {
		padding-left: 1em;
		border-left: 3px solid color-mix(in srgb, currentColor 25%, transparent);
		opacity: 0.8;
	}
	.markdown-body code {
		font-family: 'SF Mono', Monaco, 'Courier New', monospace;
		font-size: 0.875em;
		padding: 0.1em 0.3em;
		border-radius: 3px;
		background: color-mix(in srgb, currentColor 8%, transparent);
	}
	.markdown-body pre {
		padding: 1rem;
		overflow-x: auto;
		border-radius: 3px;
		background: color-mix(in srgb, currentColor 6%, transparent);
	}
	.markdown-body pre code {
		padding: 0;
		background: none;
	}
	.markdown-body table { border-collapse: collapse; }
	.markdown-body th,
	.markdown-body td {
		padding: 0.4em 0.8em;
		border: 1px solid color-mix(in srgb, currentColor 20%, transparent);
	}
	.markdown-body hr {
		margin: 1.5em 0;
		border: 0;
		border-top: 1px solid color-mix(in srgb, currentColor 15%, transparent);
	}
	.markdown-body img {
		max-width: 100%;
		height: auto;
		border-radius: 3px;
	}
</style>
